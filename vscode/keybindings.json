[
  // ── Which-Key Menu Trigger (Normal Mode) ──────────────────────────────────
  {
    "key": "space",
    "command": "whichkey.show",
    "when": "editorTextFocus && neovim.init && neovim.mode == normal",
    "args": [
      {
        "key": "w",
        "name": "Save File",
        "type": "command",
        "command": "workbench.action.files.save"
      },
      {
        "key": "q",
        "name": "Close Editor",
        "type": "command",
        "command": "workbench.action.closeActiveEditor"
      },
      {
        "key": "Q",
        "name": "Close All Editors",
        "type": "command",
        "command": "workbench.action.closeAllEditors"
      },
      {
        "key": "e",
        "name": "Toggle Explorer",
        "type": "command",
        "command": "workbench.view.explorer"
      },
      {
        "key": "o",
        "name": "Focus Explorer",
        "type": "command",
        "command": "workbench.files.action.focusFilesExplorer"
      },
      {
        "key": "y",
        "name": "Yank to OS Clipboard",
        "type": "command",
        "command": "vscode-neovim.send",
        "args": "\"+y"
      },
      {
        "key": "Y",
        "name": "Yank Line to OS Clipboard",
        "type": "command",
        "command": "vscode-neovim.send",
        "args": "\"+Y"
      },
      {
        "key": "p",
        "name": "Paste from OS Clipboard",
        "type": "command",
        "command": "vscode-neovim.send",
        "args": "\"+p"
      },
      {
        "key": "P",
        "name": "Paste Before from OS Clipboard",
        "type": "command",
        "command": "vscode-neovim.send",
        "args": "\"+P"
      },
      {
        "key": "f",
        "name": "+Find / Navigation",
        "type": "bindings",
        "bindings": [
          { "key": "f", "name": "Find Files (Quick Open)", "type": "command", "command": "workbench.action.quickOpen" },
          { "key": "g", "name": "Live Grep (Find in Files)", "type": "command", "command": "workbench.action.findInFiles" },
          { "key": "b", "name": "Find Buffers (Open Editors)", "type": "command", "command": "workbench.action.showAllEditorsByMostRecentlyUsed" },
          { "key": "r", "name": "Recent Files", "type": "command", "command": "workbench.action.openRecent" },
          { "key": "s", "name": "Search Current Buffer", "type": "command", "command": "actions.find" },
          { "key": "h", "name": "Help / Keybindings", "type": "command", "command": "workbench.action.openGlobalKeybindings" },
          { "key": "n", "name": "New File", "type": "command", "command": "workbench.action.files.newUntitledFile" }
        ]
      },
      {
        "key": "c",
        "name": "+Code / LSP",
        "type": "bindings",
        "bindings": [
          { "key": "a", "name": "Code Action / Quick Fix", "type": "command", "command": "editor.action.quickFix" },
          { "key": "f", "name": "Format Document", "type": "command", "command": "editor.action.formatDocument" },
          { "key": "d", "name": "Show Diagnostics / Hover", "type": "command", "command": "editor.action.showHover" },
          { "key": "r", "name": "Go to References", "type": "command", "command": "editor.action.goToReferences" },
          { "key": "i", "name": "Go to Implementation", "type": "command", "command": "editor.action.goToImplementation" }
        ]
      },
      {
        "key": "r",
        "name": "+Refactor",
        "type": "bindings",
        "bindings": [
          { "key": "n", "name": "Rename Symbol", "type": "command", "command": "editor.action.rename" }
        ]
      },
      {
        "key": "s",
        "name": "+Split Window",
        "type": "bindings",
        "bindings": [
          { "key": "v", "name": "Split Vertically", "type": "command", "command": "workbench.action.splitEditor" },
          { "key": "h", "name": "Split Horizontally", "type": "command", "command": "workbench.action.splitEditorOrthogonal" },
          { "key": "e", "name": "Equalize Splits", "type": "command", "command": "workbench.action.evenEditorWidths" },
          { "key": "x", "name": "Close Split Group", "type": "command", "command": "workbench.action.closeEditorsInGroup" }
        ]
      },
      {
        "key": "b",
        "name": "+Buffer",
        "type": "bindings",
        "bindings": [
          { "key": "d", "name": "Close Current Buffer", "type": "command", "command": "workbench.action.closeActiveEditor" },
          { "key": "a", "name": "Close Other Buffers", "type": "command", "command": "workbench.action.closeOtherEditors" }
        ]
      },
      {
        "key": "g",
        "name": "+Git / Diff",
        "type": "bindings",
        "bindings": [
          { "key": "d", "name": "Git Diff", "type": "command", "command": "git.openChange" },
          { "key": "D", "name": "Close Diff", "type": "command", "command": "workbench.action.closeActiveEditor" },
          { "key": "s", "name": "Git Source Control", "type": "command", "command": "workbench.view.scm" },
          { "key": "l", "name": "Git Graph", "type": "command", "command": "gitlens.showGraphPage" },
          { "key": "h", "name": "File History", "type": "command", "command": "gitlens.showQuickFileHistory" }
        ]
      },
      {
        "key": "h",
        "name": "+Git Hunk",
        "type": "bindings",
        "bindings": [
          { "key": "p", "name": "Next Git Change / Hunk", "type": "command", "command": "workbench.action.editor.nextChange" },
          { "key": "P", "name": "Previous Git Change / Hunk", "type": "command", "command": "workbench.action.editor.previousChange" },
          { "key": "b", "name": "Toggle Git Blame (GitLens)", "type": "command", "command": "gitlens.toggleFileBlame" }
        ]
      },
      {
        "key": "m",
        "name": "+Markdown",
        "type": "bindings",
        "bindings": [
          { "key": "p", "name": "Toggle Markdown Preview", "type": "command", "command": "markdown.showPreviewToSide" }
        ]
      },
      {
        "key": "t",
        "name": "+Theme / Toggle",
        "type": "bindings",
        "bindings": [
          { "key": "h", "name": "Select Color Theme", "type": "command", "command": "workbench.action.selectTheme" },
          { "key": "t", "name": "Toggle Terminal", "type": "command", "command": "workbench.action.terminal.toggleTerminal" }
        ]
      }
    ]
  },

  // ── Which-Key Menu Trigger (Visual Mode) ──────────────────────────────────
  {
    "key": "space",
    "command": "whichkey.show",
    "when": "editorTextFocus && neovim.init && neovim.mode == visual",
    "args": [
      {
        "key": "y",
        "name": "Yank to OS Clipboard",
        "type": "command",
        "command": "vscode-neovim.send",
        "args": "\"+y"
      },
      {
        "key": "p",
        "name": "Paste from OS Clipboard",
        "type": "command",
        "command": "vscode-neovim.send",
        "args": "\"+p"
      },
      {
        "key": "P",
        "name": "Paste Before from OS Clipboard",
        "type": "command",
        "command": "vscode-neovim.send",
        "args": "\"+P"
      },
      {
        "key": "c",
        "name": "+Code / LSP",
        "type": "bindings",
        "bindings": [
          { "key": "a", "name": "Code Action / Quick Fix", "type": "command", "command": "editor.action.quickFix" }
        ]
      }
    ]
  },

  // ── Split Window Navigation (Ctrl+h/j/k/l) ────────────────────────────────
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "editorTextFocus && neovim.init && neovim.mode == normal"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "editorTextFocus && neovim.init && neovim.mode == normal"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "editorTextFocus && neovim.init && neovim.mode == normal"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "editorTextFocus && neovim.init && neovim.mode == normal"
  },

  // ── Buffer / Tab Navigation (Shift+h/l) ───────────────────────────────────
  {
    "key": "shift+h",
    "command": "workbench.action.previousEditor",
    "when": "editorTextFocus && neovim.init && neovim.mode == normal"
  },
  {
    "key": "shift+l",
    "command": "workbench.action.nextEditor",
    "when": "editorTextFocus && neovim.init && neovim.mode == normal"
  }
]
