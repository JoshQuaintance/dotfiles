// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed

{
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry",
    },
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "terminal": {
    "font_size": 13.0,
    "font_family": "FiraCode Nerd Font Mono",
    "font_fallbacks": ["monospace"],
    "blinking": "on",
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
  },
  "tabs": {
    "file_icons": true,
  },
  "minimap": {
    "show": "never",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_fallbacks": ["Miracode", "Monocraft Nerd Font", "FiraFlott"],
  "buffer_font_family": "Miracode",
  "colorize_brackets": true,
  "auto_indent_on_paste": true,
  "linked_edits": true,
  "semantic_tokens": "full",
  "line_ending": "prefer_lf",
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "hard_tabs": false,
  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "theme": "Bearded Theme Arc",
}
