# ==========================================
# General & Editor Aliases
# ==========================================
alias v="nvim"
alias vi="nvim"
alias vim="nvim"

# Git Ignore generator alias
alias gi="genignore"

# Navigation & Projects
alias cd..="cd .."
alias codes="cd ~/Codes/"

# Directory Listing (eza with icons & git status)
if command -v eza &>/dev/null; then
  alias l="eza --icons --group-directories-first"
  alias ll="eza -la --icons --octal-permissions --group-directories-first --git"
  alias lt="eza --tree --level=2 --icons"
  alias tree="eza --tree --icons"
fi

# Environment & Python
alias pyactivate="source ./venv/bin/activate"

# Package Managers
alias npmwin="npm i --legacy-peer-deps --verbose"
alias npmv="npm i --verbose"
alias npmi-clean="rm -rf node_modules package-lock.json && npm install"

# ==========================================
# Ports & Process Management
# ==========================================
port() { lsof -i :"$1"; }

killport() {
  local pid
  pid=$(lsof -ti :"$1")
  if [ -n "$pid" ]; then
    kill -9 "$pid" && echo "Killed process $pid on port $1"
  else
    echo "No process running on port $1"
  fi
}

# ==========================================
# Network & System Info
# ==========================================
alias myip="curl -s https://icanhazip.com"
alias localip="ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print \$1}'"
alias reload="exec zsh -l"

# ==========================================
# Git Shortcuts
# ==========================================

# Status
alias gs="git status -sb"
alias gss="git status"

# Add
alias ga="git add"
alias gaa="git add --all"
alias gap="git add --patch"

# Commit
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias gcan="git commit --amend --no-edit"

# Branch & Checkout
alias gb="git branch"
alias gba="git branch -a"
alias gbd="git branch -d"
alias gbD="git branch -D"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gsw="git switch"
alias gswc="git switch -c"

# Diff
alias gd="git diff"
alias gds="git diff --staged"
alias gdw="git diff --word-diff"

# Push & Pull
alias gp="git push"
alias gpf="git push --force-with-lease"
alias gpu='git push -u origin $(git branch --show-current 2>/dev/null)'
alias gpl="git pull"
alias gpr="git pull --rebase"

# Log & History
alias gl="git log --oneline --graph --decorate"
alias glo="git log --oneline --graph --decorate -n 20"
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gshow="git show --stat"
gsearch() { git log --all --grep="$1" --oneline; }

# Stash
alias gst="git stash"
alias gstp="git stash pop"
alias gstl="git stash list"
alias gstd="git stash drop"

# Rebase & Cherry-Pick
alias grb="git rebase"
alias grba="git rebase --abort"
alias grbc="git rebase --continue"
alias gcp="git cherry-pick"
alias gcpa="git cherry-pick --abort"
alias gcpc="git cherry-pick --continue"

# Reset & Restore
alias grh="git reset"
alias grhh="git reset --hard"
alias guncommit="git reset --soft HEAD~1"
alias grs="git restore"
alias grss="git restore --staged"

# Branch Cleanup (deletes local branches already merged into main/master/develop)
alias gbclean="git branch --merged | grep -Ev '(\*|master|main|develop|staging)' | xargs -r git branch -d 2>/dev/null || git branch --merged | grep -Ev '(\*|master|main|develop|staging)' | xargs git branch -d"
