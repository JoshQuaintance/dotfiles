# Random ones

alias phcpy="scrcpy --turn-screen-off --no-audio"


# ==========================================
# General & Editor Aliases
# ==========================================
alias v="nvim"
alias vi="nvim"
alias vim="nvim"

# Git Ignore generator alias
alias gi="genignore"

# Navigation & Projects
alias cd..="cd .."
alias codes="cd ~/Codes/"
take() { mkdir -p "$1" && cd "$1"; }
alias groot='cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"'
alias path="echo \$PATH | tr ':' '\n'"
alias diskuse="du -sh * 2>/dev/null | sort -h"

# Safety Defaults
alias cp="cp -i"
alias mv="mv -i"
alias df="df -h"

# Directory Listing (eza with icons & git status)
if command -v eza &>/dev/null; then
  alias l="eza --icons --group-directories-first"
  alias ll="eza -la --icons --octal-permissions --group-directories-first --git"
  alias lt="eza --tree --level=2 --icons"
  alias tree="eza --tree --icons"
fi

# Environment & Python
alias pyactivate="source ./venv/bin/activate"

# ==========================================
# Package Managers & Interactive Script Runners
# ==========================================
alias npmwin="npm i --legacy-peer-deps --verbose"
alias npmv="npm i --verbose"
alias npmi-clean="rm -rf node_modules package-lock.json && npm install"

_find_package_json() {
  local dir="$PWD"
  while [ "$dir" != "/" ] && [ -n "$dir" ]; do
    if [ -f "$dir/package.json" ]; then
      echo "$dir/package.json"
      return 0
    fi
    if [ -d "$dir/.git" ] || [ -f "$dir/.git" ]; then
      break
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

_extract_pkg_scripts() {
  local pkg_file="$1"
  if command -v jq &>/dev/null; then
    jq -r 'if .scripts then .scripts | to_entries[] | "\(.key)\t\(.value)" else empty end' "$pkg_file" 2>/dev/null
  elif command -v node &>/dev/null; then
    node -e '
      try {
        const fs = require("fs");
        const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        if (pkg.scripts) {
          for (const [k, v] of Object.entries(pkg.scripts)) {
            console.log(k + "\t" + v);
          }
        }
      } catch (e) {}
    ' "$pkg_file" 2>/dev/null
  elif command -v bun &>/dev/null; then
    bun -e '
      try {
        const fs = require("fs");
        const pkg = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
        if (pkg.scripts) {
          for (const [k, v] of Object.entries(pkg.scripts)) {
            console.log(k + "\t" + v);
          }
        }
      } catch (e) {}
    ' "$pkg_file" 2>/dev/null
  fi
}

_pkg_script_select() {
  local runner="${1:-npm}"
  local pkg_file
  pkg_file=$(_find_package_json)

  if [ -z "$pkg_file" ] || [ ! -f "$pkg_file" ]; then
    command "$runner" run
    return $?
  fi

  local raw_scripts
  raw_scripts=$(_extract_pkg_scripts "$pkg_file")

  if [ -z "$raw_scripts" ]; then
    printf "\033[33mNo scripts found in %s\033[0m\n" "$pkg_file" >&2
    return 1
  fi

  if ! command -v fzf &>/dev/null; then
    printf "\033[33mfzf not found. Falling back to %s run...\033[0m\n" "$runner" >&2
    command "$runner" run
    return $?
  fi

  local max_len
  max_len=$(echo "$raw_scripts" | awk -F'\t' 'BEGIN { max=0 } { if (length($1) > max) max=length($1) } END { if (max < 16) max=16; if (max > 32) max=32; print max }')

  local formatted
  formatted=$(echo "$raw_scripts" | awk -F'\t' -v len="$max_len" '{ printf "\033[1;36m%-" len "s\033[0m \033[90m│\033[0m %s\t%s\n", $1, $2, $1 }')

  local selection
  selection=$(echo "$formatted" | fzf \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --disabled \
    --height=~50% \
    --min-height=10 \
    --layout=reverse \
    --border=rounded \
    --info=inline \
    --pointer="▶" \
    --prompt="⚡ $runner run > " \
    --header="  j/k: navigate │ /: search │ enter: run │ q: quit" \
    --color="header:italic:dim,prompt:bold:cyan,pointer:bold:green" \
    --bind="j:down,k:up,g:first,G:last,q:abort,ctrl-c:abort,ctrl-j:down,ctrl-k:up,ctrl-n:down,ctrl-p:up,down:down,up:up,enter:accept" \
    --bind="/:enable-search+unbind(j,k,q,g,G)+change-prompt(🔍 filter > )+change-header(  type to filter │ esc: normal mode │ enter: run)" \
    --bind="esc:disable-search+clear-query+rebind(j,k,q,g,G)+change-prompt(⚡ $runner run > )+change-header(  j/k: navigate │ /: search │ enter: run │ q: quit)")

  local selected
  selected=$(echo "$selection" | awk -F'\t' '{print $2}')

  if [ -n "$selected" ]; then
    printf "\033[1;32m➜\033[0m \033[1;36m%s run %s\033[0m\n" "$runner" "$selected"
    command "$runner" run "$selected"
  fi
}

# npm / bun / pnpm wrappers (intercept 'run' without arguments)
npm() {
  if [ "$1" = "run" ] && [ "$#" -eq 1 ]; then
    _pkg_script_select npm
  else
    command npm "$@"
  fi
}

bun() {
  if [ "$1" = "run" ] && [ "$#" -eq 1 ]; then
    _pkg_script_select bun
  else
    command bun "$@"
  fi
}

pnpm() {
  if [ "$1" = "run" ] && [ "$#" -eq 1 ]; then
    _pkg_script_select pnpm
  else
    command pnpm "$@"
  fi
}

# Direct shortcuts: npmr, bunr, pnpmr
npmr() {
  if [ "$#" -eq 0 ]; then
    _pkg_script_select npm
  else
    command npm run "$@"
  fi
}

bunr() {
  if [ "$#" -eq 0 ]; then
    _pkg_script_select bun
  else
    command bun run "$@"
  fi
}

pnpmr() {
  if [ "$#" -eq 0 ]; then
    _pkg_script_select pnpm
  else
    command pnpm run "$@"
  fi
}

# ==========================================
# Ports & Process Management
# ==========================================
port() { lsof -i :"$1"; }

killport() {
  local pid
  pid=$(lsof -ti :"$1")
  if [ -n "$pid" ]; then
    kill -9 "$pid" && echo "Killed process $pid on port $1"
  else
    echo "No process running on port $1"
  fi
}

# ==========================================
# Shell Reload & System Info
# ==========================================
alias sz="source ~/.zshrc && echo '✔ ~/.zshrc sourced!'"
alias src="source ~/.zshrc && echo '✔ ~/.zshrc sourced!'"
alias reload="exec zsh -l"
alias myip="curl -s https://icanhazip.com"
alias localip="ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print \$1}'"

# ==========================================
# Dotfiles Management & Updates
# ==========================================
dotupdate() {
  local check_only=false
  if [ "$1" = "-c" ] || [ "$1" = "--check" ]; then
    check_only=true
  fi

  # Resolve dotfiles directory
  local dotfiles_dir="${DOTFILES_DIR:-}"
  if [ -z "$dotfiles_dir" ] || [ ! -d "$dotfiles_dir/.git" ]; then
    if [ -L "$HOME/.zshrc" ]; then
      local link_target
      link_target="$(readlink -f "$HOME/.zshrc" 2>/dev/null || readlink "$HOME/.zshrc")"
      dotfiles_dir="$(cd "$(dirname "$link_target")" 2>/dev/null && pwd)"
    fi
  fi
  if [ -z "$dotfiles_dir" ] || [ ! -d "$dotfiles_dir/.git" ]; then
    dotfiles_dir="$HOME/Codes/dotfiles"
  fi
  if [ ! -d "$dotfiles_dir/.git" ]; then
    dotfiles_dir="$HOME/.dotfiles"
  fi
  if [ ! -d "$dotfiles_dir/.git" ]; then
    printf "\033[31m✖ Dotfiles repository not found at %s\033[0m\n" "$dotfiles_dir" >&2
    return 1
  fi

  printf "\033[1;34m==>\033[0m Checking for dotfiles updates in \033[1m%s\033[0m...\n" "$dotfiles_dir"

  # Fetch latest remote changes
  if ! git -C "$dotfiles_dir" fetch --quiet origin 2>/dev/null; then
    printf "\033[33m⚠ Warning: Failed to fetch from origin. Check network or git credentials.\033[0m\n" >&2
    return 1
  fi

  local current_branch
  current_branch="$(git -C "$dotfiles_dir" branch --show-current 2>/dev/null || echo "main")"
  local upstream
  upstream="$(git -C "$dotfiles_dir" rev-parse --abbrev-ref "@{u}" 2>/dev/null || echo "origin/$current_branch")"

  local local_rev remote_rev
  local_rev="$(git -C "$dotfiles_dir" rev-parse HEAD 2>/dev/null)"
  remote_rev="$(git -C "$dotfiles_dir" rev-parse "$upstream" 2>/dev/null)"

  if [ -z "$remote_rev" ]; then
    printf "\033[33m⚠ Warning: Upstream branch %s not found.\033[0m\n" "$upstream" >&2
    return 1
  fi

  local behind ahead
  behind="$(git -C "$dotfiles_dir" rev-list --count HEAD.."$remote_rev" 2>/dev/null || echo 0)"
  ahead="$(git -C "$dotfiles_dir" rev-list --count "$remote_rev"..HEAD 2>/dev/null || echo 0)"

  # Check working tree status
  local is_dirty=false
  if [ -n "$(git -C "$dotfiles_dir" status --porcelain 2>/dev/null)" ]; then
    is_dirty=true
  fi

  if [ "$behind" -eq 0 ] && [ "$ahead" -eq 0 ]; then
    printf "\033[32m✔\033[0m Dotfiles are up to date with \033[1m%s\033[0m (commit \033[36m%s\033[0m).\n" "$upstream" "$(git -C "$dotfiles_dir" rev-parse --short HEAD)"
    if [ "$is_dirty" = true ]; then
      printf "\033[33m⚠ Note: You have local uncommitted changes in %s\033[0m\n" "$dotfiles_dir"
    fi
    return 0
  fi

  if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
    printf "\033[31m✖ Dotfiles branch has diverged from %s (%d commit(s) ahead, %d commit(s) behind).\033[0m\n" "$upstream" "$ahead" "$behind"
    git -C "$dotfiles_dir" log --graph --oneline -n 10 HEAD "$remote_rev"
    return 1
  fi

  if [ "$ahead" -gt 0 ] && [ "$behind" -eq 0 ]; then
    printf "\033[32m✔\033[0m Local dotfiles are ahead of \033[1m%s\033[0m by %d commit(s) (unpushed).\n" "$upstream" "$ahead"
    git -C "$dotfiles_dir" log --oneline "$remote_rev"..HEAD
    return 0
  fi

  # Behind remote (updates available)
  printf "\033[1;33m⬇ %d update(s) available for your dotfiles from %s:\033[0m\n\n" "$behind" "$upstream"
  git -C "$dotfiles_dir" log --format="  \033[33m%h\033[0m \033[36m%cr\033[0m \033[1m%s\033[0m \033[90m(%an)\033[0m" HEAD.."$remote_rev"
  echo ""

  if [ "$check_only" = true ]; then
    printf "Run \033[1;36mdotupdate\033[0m to pull and apply these updates.\n"
    return 0
  fi

  if [ "$is_dirty" = true ]; then
    printf "\033[33m⚠ You have uncommitted changes in %s. Please commit or stash them before updating.\033[0m\n" "$dotfiles_dir"
    git -C "$dotfiles_dir" status -s
    return 1
  fi

  local reply
  printf "Would you like to pull and apply updates now? [Y/n]: "
  if [ -t 0 ]; then
    read -r reply
  elif [ -r /dev/tty ]; then
    read -r reply < /dev/tty 2>/dev/null || reply="y"
  else
    read -r reply
  fi

  if [[ "$reply" =~ ^[Nn]$ ]]; then
    echo "Updates postponed."
    return 0
  fi

  printf "\033[1;34m==>\033[0m Pulling updates via git pull --rebase...\n"
  if git -C "$dotfiles_dir" pull --rebase origin "$current_branch"; then
    printf "\033[32m✔\033[0m Dotfiles successfully updated!\n"

    # Reload shell configuration if in interactive zsh
    if [ -f "$HOME/.zshrc" ] && [ -n "$ZSH_VERSION" ]; then
      printf "\033[1;34m==>\033[0m Reloading ~/.zshrc...\n"
      source "$HOME/.zshrc"
      printf "\033[32m✔\033[0m Shell configuration reloaded!\n"
    fi
  else
    printf "\033[31m✖ Git pull failed. Please check %s\033[0m\n" "$dotfiles_dir" >&2
    return 1
  fi
}

dotcheck() {
  dotupdate --check "$@"
}

alias dotfiles-update="dotupdate"
alias dotfiles-check="dotcheck"

# ==========================================
# Git Shortcuts
# ==========================================

# Status
alias gs="git status -sb"
alias gss="git status"

# Add
alias ga="git add"
alias gaa="git add --all"
alias gap="git add --patch"

# Commit
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias gcan="git commit --amend --no-edit"

# Branch & Checkout
alias gb="git branch"
alias gba="git branch -a"
alias gbd="git branch -d"
alias gbD="git branch -D"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gsw="git switch"
alias gswc="git switch -c"

# Diff
alias gd="git diff"
alias gds="git diff --staged"
alias gdw="git diff --word-diff"

# Push & Pull
alias gp="git push"
alias gpf="git push --force-with-lease"
alias gpu='git push -u origin $(git branch --show-current 2>/dev/null)'
alias gpl="git pull"
alias gpr="git pull --rebase"

# Log & History
alias gl="git log --oneline --graph --decorate"
alias glo="git log --oneline --graph --decorate -n 20"
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gshow="git show --stat"
gsearch() { git log --all --grep="$1" --oneline; }

# Stash
alias gst="git stash"
alias gstp="git stash pop"
alias gstl="git stash list"
alias gstd="git stash drop"

# Rebase & Cherry-Pick
alias grb="git rebase"
alias grba="git rebase --abort"
alias grbc="git rebase --continue"
alias gcp="git cherry-pick"
alias gcpa="git cherry-pick --abort"
alias gcpc="git cherry-pick --continue"

# Reset & Restore
alias grh="git reset"
alias grhh="git reset --hard"
alias guncommit="git reset --soft HEAD~1"
alias grs="git restore"
alias grss="git restore --staged"

# Branch Cleanup & Prune
alias gprune="git fetch --prune"
alias gbclean="git branch --merged | grep -Ev '(\*|master|main|develop|staging)' | xargs -r git branch -d 2>/dev/null || git branch --merged | grep -Ev '(\*|master|main|develop|staging)' | xargs git branch -d"

# ==========================================
# Git Worktree Shortcuts
# ==========================================
alias gwt="git worktree"
alias gwtl="git worktree list"
alias gwta="git worktree add"
alias gwtb="git worktree add -b"
alias gwtr="git worktree remove"
alias gwtrm="git worktree remove"
alias gwtp="git worktree prune"
