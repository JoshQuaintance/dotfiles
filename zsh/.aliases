# General and system aliases

# Editor & CLI tools
alias v="nvim"
alias vi="nvim"
alias vim="nvim"
alias gi="genignore" # Interactive .gitignore generator
alias phcpy="scrcpy --turn-screen-off --no-audio" # Mirror Android phone screen via scrcpy
alias lg="lazygit" # Terminal UI for Git
if command -v btop &>/dev/null; then
  alias top="btop" # Modern system resource monitor
  alias htop="btop" # Modern system resource monitor
fi
if command -v trash &>/dev/null; then
  alias del="trash" # Move files to system Trash instead of permanent rm
fi

# Navigation & Directories
alias cd..="cd .."
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias codes="cd ~/Codes/" # Jump to ~/Codes workspace
alias path="echo \$PATH | tr ':' '\n'" # Print each PATH entry on its own line
alias x="extract" # Universal archive extractor
alias kp="fkill" # Interactive process & port killer
alias dps="fcon" # Interactive Docker/Podman container manager
alias cheat="cheath" # Interactive tldr cheat-sheet browser
if command -v tokei &>/dev/null; then
  alias loc="tokei" # Count lines of code by language
  alias cloc="tokei" # Count lines of code by language
fi
if command -v dust &>/dev/null; then
  alias diskuse="dust" # Visual disk usage analyzer
else
  alias diskuse="du -sh * 2>/dev/null | sort -h" # Disk usage sorted by size
fi

# Safety Defaults
alias cp="cp -i"
alias mv="mv -i"
alias df="df -h"

# Modern Directory Listing (eza) — smart 'tree' & 'lt' live in zsh/functions/navigation.zsh
if command -v eza &>/dev/null; then
  alias l="eza --icons --group-directories-first"
  alias ll="eza -la --icons --octal-permissions --group-directories-first --git"
fi
alias als="toggle-autols" # Toggle automatic directory listing after cd
alias autols="toggle-autols" # Toggle automatic directory listing after cd
alias autonotify="toggle-autonotify" # Toggle desktop notifications for long commands (>15s)
alias aliases="fa" # Fuzzy search all aliases, functions & tools
alias falias="fa" # Fuzzy search all aliases, functions & tools

# Python virtual environment (detects .venv or venv)
alias pyactivate='[ -f "./.venv/bin/activate" ] && source ./.venv/bin/activate || ([ -f "./venv/bin/activate" ] && source ./venv/bin/activate || echo "No .venv or venv found in current directory")' # Activate .venv or venv in current directory

# Node & Package Managers
alias npmv="npm i --verbose" # Install npm packages with verbose output
alias npmi-clean="rm -rf node_modules package-lock.json && npm install" # Wipe node_modules + lockfile and reinstall

# Shell Reload & Network Info
alias sz="source ~/.zshrc && echo '✔ ~/.zshrc sourced!'" # Reload ~/.zshrc in current shell
alias src="source ~/.zshrc && echo '✔ ~/.zshrc sourced!'" # Reload ~/.zshrc in current shell
alias reload="exec zsh -l" # Replace current shell with a fresh login Zsh process
alias alert="notify" # Send persistent desktop alert notification
alias myip="curl -s https://icanhazip.com" # Print public external IP address
alias localip="ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print \$1}'" # Print local LAN IP address

# Dotfiles Maintenance Shortcuts
alias .status="dot status" # Quick workstation & dotfiles overview
alias .s="dot status" # Quick workstation & dotfiles overview
alias .doctor="dotdoctor" # Full system & symlink health check
alias .check="dotcheck" # Check if dotfiles repo has upstream updates
alias .update="dotupdate" # Pull dotfiles & upgrade Brew / Mise packages
alias .bench="dot bench" # Profile interactive Zsh startup latency
alias .clean="dot clean" # Prune stale caches, completion dumps & scratch files
alias .branch="dotbranch" # Switch active ~/.dotfiles branch & reload shell
alias .b="dotbranch" # Switch active ~/.dotfiles branch & reload shell

# ==========================================
# Git Shortcuts
# ==========================================

# Status & Inspection
alias gs="git status -sb"
alias gss="git status"
alias gd="git diff"
alias gds="git diff --staged" # Diff staged changes
alias gdw="git diff --word-diff" # Word-level git diff
alias gdside="git -c delta.side-by-side=true diff" # Side-by-side git diff via delta
alias gshow="git show --stat"

# Add & Commit
unalias ga 2>/dev/null || true
alias gadd="ga" # Interactive FZF git staging & hunk reviewer
alias gaa="git add --all"
alias gap="git add --patch" # Interactively stage hunks
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend" # Amend previous commit
alias gcan="git commit --amend --no-edit" # Amend previous commit without changing message

# Branch & Switch
alias gb="git branch"
alias gba="git branch -a"
alias gbd="git branch -d"
alias gbD="git branch -D"
unalias gco 2>/dev/null || true
alias gcb="git checkout -b"
alias gsw="git switch"
alias gswc="git switch -c"

# Push & Pull
alias gp="git push"
alias gpf="git push --force-with-lease" # Safe force-push with lease check
alias gpu='git push -u origin $(git branch --show-current 2>/dev/null)' # Push current branch and set upstream
alias gpl="git pull"
alias gpr="git pull --rebase" # Pull with rebase

# History & Log
unalias gl 2>/dev/null || true
alias gfh="gfile" # Interactive FZF git history for a single file
alias glo="git log --oneline --graph --decorate -n 20"
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"

# Stash
alias gst="git stash"
alias gstp="git stash pop"
alias gstl="gstash" # Interactive FZF git stash manager
alias gstd="git stash drop"

# Rebase & Cherry-Pick
alias grb="git rebase"
alias grba="git rebase --abort"
alias grbc="git rebase --continue"
alias gcp="git cherry-pick"
alias gcpa="git cherry-pick --abort"
alias gcpc="git cherry-pick --continue"

# Reset & Restore
alias grh="git reset"
alias grhh="git reset --hard"
alias guncommit="git reset --soft HEAD~1" # Undo last commit keeping changes staged
alias grs="git restore"
alias grss="git restore --staged" # Unstage files without discarding changes

# Branch Maintenance
alias gprune="git fetch --prune" # Fetch and prune deleted remote branches

# Git Worktrees
alias gwt="git worktree"
alias gwtl="git worktree list"
alias gwtstatus="gwts" # Fleet status dashboard across all worktrees
alias gwta="git worktree add"
alias gwtb="git worktree add -b"
alias gwtr="git worktree remove"
alias gwtrm="gwtdel" # Interactive FZF worktree & branch remover
alias gwtp="git worktree prune"
alias gwtc="gwtclean" # Prune worktrees whose remote branch was merged/deleted
alias gwtprune="gwtclean" # Prune worktrees whose remote branch was merged/deleted
alias gwtn="gwtnew" # Create or checkout a branch in a new worktree


