# Ghostty Terminal Configuration
# Theme: Catppuccin Mocha (darkest variant)
theme = Catppuccin Mocha

# Font settings (Miracode primary, FiraCode Nerd Font fallback)
font-family = Miracode
font-family = FiraCode Nerd Font
font-size = 14

# Window styling & padding
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = transparent

# Cursor, Clipboard & Shell Integration
cursor-style = block
cursor-style-blink = false
shell-integration-features = ssh-terminfo,ssh-env
macos-option-as-alt = true
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
window-save-state = always
window-inherit-working-directory = true
link-url = true
confirm-close-surface = false
mouse-hide-while-typing = true
quit-after-last-window-closed = true

# Split & Pane Navigation Keybindings (cross-platform parity with Windows Terminal)
keybind = alt+shift+d=new_split:right
keybind = alt+shift+minus=new_split:down
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+shift+z=toggle_split_zoom
keybind = alt+shift+equal=equalize_splits
keybind = ctrl+shift+w=close_surface
