# Global Git configuration with modern engineering defaults

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true
    followTags = true
    useForceIfIncludes = true

[branch]
    sort = -committerdate

[column]
    ui = auto

[tag]
    sort = version:refname

[fetch]
    prune = true
    pruneTags = false
    writeCommitGraph = true
    parallel = 0

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = zebra
    colorMovedWS = allow-indentation-change
    algorithm = histogram
    renames = true
    mnemonicPrefix = true
    interHunkContext = 3
    submodule = log

[feature]
    manyFiles = true

[status]
    submoduleSummary = true

[log]
    date = iso

[core]
    excludesfile = ~/.gitignore_global
    autocrlf = input
    # Fall back to less / plain output when delta isn't installed (fresh machines, partial installs)
    pager = "command -v delta >/dev/null 2>&1 && exec delta || exec less -FRX"

[interactive]
    diffFilter = "command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat"

[delta]
    navigate = true
    syntax-theme = Catppuccin Mocha
    line-numbers = true
    hyperlinks = true
    decorations = true
    file-style = bold "#89b4fa"
    file-decoration-style = "#45475a" ul
    hunk-header-decoration-style = "#45475a" box ul
    hunk-header-file-style = bold "#cba6f7"
    hunk-header-line-number-style = bold "#a6e3a1"
    blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
    merge-conflict-begin-symbol = ⌄
    merge-conflict-end-symbol = ⌃
    merge-conflict-ours-diff-header-style = "#f9e2af" bold
    merge-conflict-theirs-diff-header-style = "#89b4fa" bold

[help]
    autocorrect = prompt

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[commit]
    verbose = true

# Local & private user credentials (name, email, signing key)
[include]
    path = ~/.gitconfig.local
