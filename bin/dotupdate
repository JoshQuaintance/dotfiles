#!/usr/bin/env bash
set -e

# Dotfiles updater: checks and applies upstream changes, package updates & health verification
DOTFILES_DIR="${DOTFILES_DIR:-}"

# Parse command line flags
CHECK_ONLY=false
AUTO_APPLY=false
UPDATE_ALL=false
TOOLS_ONLY=false
RUN_TESTS=false

for arg in "$@"; do
  case "$arg" in
    -c|--check) CHECK_ONLY=true ;;
    -y|--yes)   AUTO_APPLY=true ;;
    -a|--all)   UPDATE_ALL=true ;;
    -t|--tools) TOOLS_ONLY=true ;;
    --test)     RUN_TESTS=true ;;
    -h|--help)
      echo "Usage: dotupdate [OPTIONS]"
      echo "  -c, --check    Check for dotfiles updates without applying"
      echo "  -y, --yes      Automatically apply dotfiles updates without prompting"
      echo "  -a, --all      Full workstation upgrade: dotfiles git + Homebrew + Mise + dottest"
      echo "  -t, --tools    Update Homebrew packages and Mise runtimes only"
      echo "  --test         Run deep integration tests (dottest) after updating"
      echo "  -h, --help     Show this help message"
      exit 0
      ;;
  esac
done

# Resolve dotfiles repository location
if [ -z "$DOTFILES_DIR" ] || [ ! -d "$DOTFILES_DIR/.git" ]; then
  if [ -L "$HOME/.zshrc" ]; then
    link_target="$(readlink -f "$HOME/.zshrc" 2>/dev/null || readlink "$HOME/.zshrc")"
    DOTFILES_DIR="$(cd "$(dirname "$link_target")" 2>/dev/null && pwd)"
  fi
fi
if [ -z "$DOTFILES_DIR" ] || [ ! -d "$DOTFILES_DIR/.git" ]; then
  DOTFILES_DIR="$HOME/.dotfiles"
fi

if [ ! -d "$DOTFILES_DIR/.git" ]; then
  printf "\033[31m✖ Dotfiles repository not found at %s\033[0m\n" "$DOTFILES_DIR" >&2
  exit 1
fi

update_brew() {
  if command -v brew &>/dev/null; then
    printf "\n\033[1;34m==>\033[0m Updating Homebrew formulas and packages...\n"
    brew update
    brew upgrade
    printf "\033[32m✔\033[0m Homebrew packages updated successfully!\n"
  fi
}

update_mise() {
  if command -v mise &>/dev/null; then
    printf "\n\033[1;34m==>\033[0m Upgrading Mise tools and runtimes...\n"
    mise upgrade
    printf "\033[32m✔\033[0m Mise tools upgraded successfully!\n"
  fi
}

run_verification() {
  if [ -x "$DOTFILES_DIR/bin/dottest" ]; then
    printf "\n\033[1;34m==>\033[0m Running deep dotfiles test suite (dottest)...\n"
    "$DOTFILES_DIR/bin/dottest"
  fi
}

prompt_user() {
  local prompt="$1"
  local default_val="$2"
  printf "%s" "$prompt"
  local reply=""
  if [ -t 0 ]; then
    read -r reply
  elif [ -r /dev/tty ]; then
    read -r reply < /dev/tty 2>/dev/null || reply="$default_val"
  else
    read -r reply || reply="$default_val"
  fi
  echo "${reply:-$default_val}"
}

# If --tools only requested, skip git checks
if [ "$TOOLS_ONLY" = true ]; then
  update_brew
  update_mise
  if [ "$RUN_TESTS" = true ] || [ "$UPDATE_ALL" = true ]; then
    run_verification
  fi
  exit 0
fi

printf "\033[1;34m==>\033[0m Checking for dotfiles updates in \033[1m%s\033[0m...\n" "$DOTFILES_DIR"

# Fetch latest changes from remote origin
if ! git -C "$DOTFILES_DIR" fetch --quiet origin 2>/dev/null; then
  printf "\033[33m⚠ Warning: Failed to fetch from origin. Check network or credentials.\033[0m\n" >&2
  exit 1
fi

current_branch="$(git -C "$DOTFILES_DIR" branch --show-current 2>/dev/null || echo "main")"
upstream="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref "@{u}" 2>/dev/null || echo "origin/$current_branch")"
remote_rev="$(git -C "$DOTFILES_DIR" rev-parse "$upstream" 2>/dev/null || true)"

if [ -z "$remote_rev" ]; then
  printf "\033[33m⚠ Warning: Upstream branch %s not found.\033[0m\n" "$upstream" >&2
  exit 1
fi

behind="$(git -C "$DOTFILES_DIR" rev-list --count HEAD.."$remote_rev" 2>/dev/null || echo 0)"
ahead="$(git -C "$DOTFILES_DIR" rev-list --count "$remote_rev"..HEAD 2>/dev/null || echo 0)"

is_dirty=false
if [ -n "$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null)" ]; then
  is_dirty=true
fi

updated_git=false

# Up to date
if [ "$behind" -eq 0 ] && [ "$ahead" -eq 0 ]; then
  printf "\033[32m✔\033[0m Dotfiles are up to date with \033[1m%s\033[0m (commit \033[36m%s\033[0m).\n" "$upstream" "$(git -C "$DOTFILES_DIR" rev-parse --short HEAD)"
  if [ "$is_dirty" = true ]; then
    printf "\033[33m⚠ Note: You have local uncommitted changes in %s\033[0m\n" "$DOTFILES_DIR"
  fi
elif [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
  # Diverged
  printf "\033[31m✖ Dotfiles branch has diverged from %s (%d ahead, %d behind).\033[0m\n" "$upstream" "$ahead" "$behind"
  git --no-pager -C "$DOTFILES_DIR" log --graph --oneline -n 10 HEAD "$remote_rev"
  exit 1
elif [ "$ahead" -gt 0 ] && [ "$behind" -eq 0 ]; then
  # Ahead only
  printf "\033[32m✔\033[0m Local dotfiles are ahead of \033[1m%s\033[0m by %d commit(s) (unpushed).\n" "$upstream" "$ahead"
  git --no-pager -C "$DOTFILES_DIR" log --oneline "$remote_rev"..HEAD
else
  # Updates available
  printf "\033[1;33m⬇ %d update(s) available for your dotfiles from %s:\033[0m\n\n" "$behind" "$upstream"
  git --no-pager -C "$DOTFILES_DIR" log --format="  \033[33m%h\033[0m \033[36m%cr\033[0m \033[1m%s\033[0m \033[90m(%an)\033[0m" HEAD.."$remote_rev"
  echo ""

  if [ "$CHECK_ONLY" = true ]; then
    printf "Run \033[1;36mdotupdate\033[0m to pull and apply these updates.\n"
    exit 0
  fi

  if [ "$is_dirty" = true ]; then
    printf "\033[33m⚠ You have uncommitted changes in %s. Please commit or stash them before updating.\033[0m\n" "$DOTFILES_DIR"
    git -C "$DOTFILES_DIR" status -s
    exit 1
  fi

  do_apply=true
  if [ "$AUTO_APPLY" != true ] && [ "$UPDATE_ALL" != true ]; then
    resp="$(prompt_user "Would you like to pull and apply updates now? [Y/n]: " "y")"
    if [[ "$resp" =~ ^[Nn]$ ]]; then
      echo "Dotfiles updates postponed."
      do_apply=false
    fi
  fi

  if [ "$do_apply" = true ]; then
    printf "\033[1;34m==>\033[0m Pulling updates via git pull --rebase...\n"
    if git -C "$DOTFILES_DIR" pull --rebase origin "$current_branch"; then
      printf "\033[32m✔\033[0m Dotfiles successfully updated to \033[36m%s\033[0m!\n" "$(git -C "$DOTFILES_DIR" rev-parse --short HEAD)"
      updated_git=true
    else
      printf "\033[31m✖ Git pull failed. Please check %s\033[0m\n" "$DOTFILES_DIR" >&2
      exit 1
    fi
  fi
fi

if [ "$CHECK_ONLY" = true ]; then
  exit 0
fi

# Package and runtime management (Homebrew & Mise)
if [ "$UPDATE_ALL" = true ]; then
  update_brew
  update_mise
  run_verification
elif [ "$AUTO_APPLY" != true ]; then
  echo ""
  resp="$(prompt_user "Would you also like to update Homebrew packages and Mise runtimes? [y/N]: " "n")"
  if [[ "$resp" =~ ^[Yy]$ ]]; then
    update_brew
    update_mise
    run_verification
  fi
fi

if [ "$updated_git" = true ]; then
  printf "\n\033[1;36m💡 Run 'sz' to reload your active shell session.\033[0m\n"
fi
