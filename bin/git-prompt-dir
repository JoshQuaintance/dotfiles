#!/usr/bin/env bash
set -e

# Fast git worktree & repository path resolver for Starship prompt
if git rev-parse --is-inside-work-tree &>/dev/null; then
    common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
    git_dir="$(git rev-parse --git-dir 2>/dev/null)"
    toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"

    pwd_p="$(pwd -P)"
    top_p="$(cd "$toplevel" 2>/dev/null && pwd -P)"
    rel_path="${pwd_p#$top_p}"

    # Detect git worktree: common_dir differs from git_dir, or git_dir contains /worktrees/
    if [ "$common_dir" != "$git_dir" ] && [[ "$git_dir" == *"worktrees"* ]]; then
        common_base="$(basename "$common_dir")"
        if [ "$common_base" = ".git" ] || [ "$common_base" = ".bare" ]; then
            main_repo="$(basename "$(cd "$common_dir/.." 2>/dev/null && pwd -P)")"
        else
            main_repo="${common_base%.git}"
        fi
        wt_name="$(basename "$top_p")"
        dir_display="${main_repo}/${wt_name}${rel_path}"
    else
        repo_name="$(basename "$top_p")"
        repo_name="${repo_name%.git}"
        dir_display="${repo_name}${rel_path}"
    fi
else
    if [[ "$PWD" == "$HOME"* ]]; then
        dir_display="~${PWD#$HOME}"
    else
        dir_display="$PWD"
    fi
fi

# Append read-only lock icon if directory is not writable
[ ! -w "$PWD" ] && dir_display="${dir_display} 󰌾"

echo "$dir_display"
