#!/usr/bin/env bash
set -e

# Fast zero-fork git worktree & repository path resolver for Starship prompt
p="$PWD"
git_item=""
rel_path=""

while [ "$p" != "/" ] && [ -n "$p" ]; do
    if [ -e "$p/.git" ]; then
        git_item="$p/.git"
        break
    fi
    rel_path="/${p##*/}${rel_path}"
    p="${p%/*}"
done

if [ -n "$git_item" ]; then
    top_dir="$p"
    if [ -f "$git_item" ]; then
        # Git worktree: .git file contains 'gitdir: /path/to/main_repo/.bare/worktrees/<wt_name>'
        read -r gitdir_line < "$git_item"
        common_bare="${gitdir_line#gitdir: }"
        bare_dir="${common_bare%/worktrees/*}"
        main_repo_dir="${bare_dir%/*}"
        main_repo="${main_repo_dir##*/}"
        wt_name="${top_dir##*/}"
        dir_display="${main_repo}/${wt_name}${rel_path}"
    else
        repo_name="${top_dir##*/}"
        dir_display="${repo_name}${rel_path}"
    fi
else
    if [[ "$PWD" == "$HOME"* ]]; then
        dir_display="~${PWD#$HOME}"
    else
        dir_display="$PWD"
    fi
fi

# Append read-only lock icon if directory is not writable
[ ! -w "$PWD" ] && dir_display="${dir_display} 󰌾"

echo "$dir_display"
