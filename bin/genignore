#!/usr/bin/env bash
# Description: Interactive .gitignore generator using gitignore.io templates
set -e

# Color output helpers
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log() { echo -e "${BLUE}==>${NC} $1"; }
success() { echo -e "${GREEN}✔${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✖${NC} $1"; }

# 1. Parse arguments (-h/--help, -i/--interactive, or explicit tech targets)
INTERACTIVE=false
TARGETS=()

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      echo -e "${BLUE}genignore${NC} (alias: ${BLUE}gi${NC}) — Smart .gitignore generator powered by gitignore.io / toptal"
      echo ""
      echo "Usage:"
      echo "  gi                       Auto-detect project technologies & update .gitignore"
      echo "  gi <tech1> [tech2...]    Generate .gitignore for specified technologies (e.g. gi node python)"
      echo "  gi -i, --interactive     Interactive FZF multi-selector of all available templates"
      echo "  gi -h, --help            Show this help message"
      exit 0
      ;;
    -i | --interactive)
      INTERACTIVE=true
      ;;
    *)
      TARGETS+=("$arg")
      ;;
  esac
done

# 2. Determine target directory (Git root or current directory)
TARGET_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$TARGET_DIR"

GITIGNORE_FILE="$TARGET_DIR/.gitignore"
BACKUP_FILE="$TARGET_DIR/.gitignore.bak"

log "Target directory: $TARGET_DIR"

# 3. Interactive FZF template selection (-i / --interactive)
if [ "$INTERACTIVE" = true ]; then
  CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  CACHE_FILE="$CACHE_DIR/gitignore-templates.txt"
  mkdir -p "$CACHE_DIR" 2>/dev/null || true

  # Fetch or refresh template list if missing or empty
  if [ ! -s "$CACHE_FILE" ]; then
    log "Fetching available templates from gitignore.io API..."
    if command -v curl &>/dev/null; then
      curl -sL --max-time 5 "https://www.toptal.com/developers/gitignore/api/list" 2>/dev/null |
        tr ',' '\n' | tr ' ' '\n' | sed '/^$/d' | sort -u >"$CACHE_FILE" || true
    fi
  fi

  if [ ! -s "$CACHE_FILE" ]; then
    error "Could not fetch gitignore template catalog (offline or network error)."
    exit 1
  fi

  if command -v fzf &>/dev/null && [ -t 1 ]; then
    log "Select templates in FZF (Tab / Space to select multiple, Enter to confirm)..."
    SELECTED=$(fzf --multi \
      --prompt="gitignore templates > " \
      --header="Tab/Space: select │ Enter: confirm │ /: search │ Esc/q: cancel" \
      --color="header:italic:dim,prompt:bold:cyan,pointer:bold:green,marker:bold:magenta" \
      --preview='curl -sL --max-time 3 "https://www.toptal.com/developers/gitignore/api/{}" 2>/dev/null | head -n 80' \
      --preview-window='right:55%:wrap' <"$CACHE_FILE")

    if [ -z "$SELECTED" ]; then
      warn "No templates selected. Operation cancelled."
      exit 0
    fi

    while IFS= read -r item; do
      [ -n "$item" ] && TARGETS+=("$item")
    done <<<"$SELECTED"
  else
    error "Interactive mode requires fzf in an interactive terminal."
    exit 1
  fi
fi

# 4. Auto-detection if no targets were specified manually or via interactive mode
if [ "${#TARGETS[@]}" -eq 0 ]; then
  log "Scanning project technologies..."

  # Always include OS & Editor ignores
  TARGETS+=("macos" "linux" "visualstudiocode" "vim")

  # Svelte / SvelteKit
  if [ -f "svelte.config.js" ] || [ -f "svelte.config.ts" ] || grep -q '"@sveltejs/kit"' package.json 2>/dev/null || grep -q '"svelte"' package.json 2>/dev/null; then
    TARGETS+=("svelte" "sveltekit")
  fi

  # Angular
  if [ -f "angular.json" ] || grep -q '"@angular/core"' package.json 2>/dev/null; then
    TARGETS+=("angular")
  fi

  # Next.js
  if [ -f "next.config.js" ] || [ -f "next.config.ts" ] || [ -f "next.config.mjs" ] || grep -q '"next"' package.json 2>/dev/null; then
    TARGETS+=("nextjs")
  fi

  # Nuxt / Vue
  if [ -f "nuxt.config.ts" ] || [ -f "nuxt.config.js" ] || grep -q '"nuxt"' package.json 2>/dev/null; then
    TARGETS+=("nuxt")
  fi

  # Astro
  if [ -f "astro.config.mjs" ] || [ -f "astro.config.ts" ]; then
    TARGETS+=("astro")
  fi

  # Vite
  if [ -f "vite.config.js" ] || [ -f "vite.config.ts" ] || [ -f "vite.config.mjs" ]; then
    TARGETS+=("vite")
  fi

  # Node.js & TypeScript
  if [ -f "package.json" ] || [ -f "pnpm-lock.yaml" ] || [ -f "yarn.lock" ] || [ -f "bun.lockb" ]; then
    TARGETS+=("node")
  fi
  if [ -f "tsconfig.json" ]; then
    TARGETS+=("typescript")
  fi

  # Python / Astral (uv & ruff)
  if [ -f "pyproject.toml" ] || [ -f "requirements.txt" ] || [ -f "uv.lock" ] || [ -f "Pipfile" ] || [ -f "setup.py" ] || compgen -G "*.py" >/dev/null; then
    TARGETS+=("python")
  fi

  # Rust
  if [ -f "Cargo.toml" ]; then
    TARGETS+=("rust")
  fi

  # Go
  if [ -f "go.mod" ]; then
    TARGETS+=("go")
  fi

  # Java / Gradle / Maven
  if [ -f "pom.xml" ]; then
    TARGETS+=("maven" "java")
  fi
  if [ -f "build.gradle" ] || [ -f "build.gradle.kts" ] || [ -f "gradlew" ]; then
    TARGETS+=("gradle" "java")
  fi
fi

# Remove duplicates from TARGETS array (read loop: macOS ships bash 3.2 without mapfile)
UNIQUE_TARGETS=()
while IFS= read -r target; do
  [ -n "$target" ] && UNIQUE_TARGETS+=("$target")
done < <(printf '%s\n' "${TARGETS[@]}" | sort -u)

if [ "${#UNIQUE_TARGETS[@]}" -eq 0 ]; then
  warn "No specific technologies detected. Using default OS & Editor ignores."
  UNIQUE_TARGETS=("macos" "linux" "visualstudiocode" "vim")
fi

QUERY_STRING=$(
  IFS=,
  echo "${UNIQUE_TARGETS[*]}"
)
log "Target components: ${UNIQUE_TARGETS[*]}"

# 5. Backup existing .gitignore if present
if [ -f "$GITIGNORE_FILE" ]; then
  cp "$GITIGNORE_FILE" "$BACKUP_FILE"
  log "Backed up existing .gitignore to .gitignore.bak"
fi

# 6. Fetch rules from gitignore.io / toptal API or use offline fallback
log "Fetching latest gitignore rules..."
FETCHED_CONTENT=""

if command -v curl &>/dev/null; then
  FETCHED_CONTENT=$(curl -sL --max-time 5 "https://www.toptal.com/developers/gitignore/api/${QUERY_STRING}" 2>/dev/null || true)
fi

# If API returned an error or is offline, generate essential fallback rules
if [[ -z "$FETCHED_CONTENT" || "$FETCHED_CONTENT" == *"<!DOCTYPE html>"* || "$FETCHED_CONTENT" == *"#!! ERROR"* ]]; then
  warn "Network unreachable or API unavailable. Using standard offline templates..."
  FETCHED_CONTENT="# Auto-generated offline gitignore
# OS & Editors
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Node & Frontend
node_modules/
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.angular/
.angular/cache/
.vite/
.astro/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets
.env
.env.local
.env.*.local
.env.production
.env.staging

# Python & UV
__pycache__/
*.py[cod]
*\$py.class
*.so
.Python
.venv/
venv/
ENV/
.ruff_cache/
.pytest_cache/
.mypy_cache/
"
fi

# 7. Merge / Write .gitignore cleanly (Idempotent block replacement)
START_MARKER="# >>> genignore start >>>"
END_MARKER="# <<< genignore end <<<"

TEMP_MERGED=$(mktemp)

if [ -f "$GITIGNORE_FILE" ]; then
  # Strip any existing genignore-managed block (both modern marker format and legacy header)
  PRESERVED_USER_LINES=$(awk '
    /# >>> genignore start >>>/ { in_block = 1; next }
    /# <<< genignore end <<</ { in_block = 0; next }
    /# ==========================================/ {
      getline n
      if (n ~ /# Auto-generated by genignore/) {
        in_legacy = 1
        next
      } else {
        if (!in_block && !in_legacy) { print $0; print n }
        next
      }
    }
    !in_block && !in_legacy { print }
  ' "$GITIGNORE_FILE" | sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba')

  if [ -n "$PRESERVED_USER_LINES" ]; then
    printf "%s\n\n" "$PRESERVED_USER_LINES" >"$TEMP_MERGED"
  fi
fi

# Append the managed block
cat >>"$TEMP_MERGED" <<EOF
$START_MARKER
# ==========================================
# Auto-generated by genignore ($(date '+%Y-%m-%d %H:%M:%S'))
# Components: ${UNIQUE_TARGETS[*]}
# ==========================================
$FETCHED_CONTENT
$END_MARKER
EOF

# Move merged temp file into place
mv "$TEMP_MERGED" "$GITIGNORE_FILE"

success ".gitignore successfully updated at: $GITIGNORE_FILE"
