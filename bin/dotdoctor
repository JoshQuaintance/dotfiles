#!/usr/bin/env bash
set -e

# Dotfiles diagnostic health check tool
# Verifies symlinks, core development CLI tools, locale, and Git configurations

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_DIM="\033[2m"

passed=0
warnings=0
failed=0

report_ok() {
  printf "  ${C_GREEN}✔${C_RESET} %-42s ${C_DIM}%s${C_RESET}\n" "$1" "$2"
  passed=$(( passed + 1 ))
}

report_warn() {
  printf "  ${C_YELLOW}⚠${C_RESET} ${C_YELLOW}%-42s${C_RESET} ${C_DIM}%s${C_RESET}\n" "$1" "$2"
  warnings=$(( warnings + 1 ))
}

report_fail() {
  printf "  ${C_RED}✖${C_RESET} ${C_RED}%-42s${C_RESET} ${C_DIM}%s${C_RESET}\n" "$1" "$2"
  failed=$(( failed + 1 ))
}

echo ""
printf "${C_CYAN}╭────────────────────────────────────────────────────────╮${C_RESET}\n"
printf "${C_CYAN}│${C_RESET}  ${C_BOLD}Dotfiles Doctor — System & Environment Health Check${C_RESET}   ${C_CYAN}│${C_RESET}\n"
printf "${C_CYAN}╰────────────────────────────────────────────────────────╯${C_RESET}\n"
echo ""

# 1. Dotfiles Repository Status
printf "${C_BOLD}1. Dotfiles Repository${C_RESET}\n"
DOTFILES_DIR="${DOTFILES_DIR:-}"
if [ -z "$DOTFILES_DIR" ] || [ ! -d "$DOTFILES_DIR/.git" ]; then
  if [ -L "$HOME/.zshrc" ]; then
    link_target="$(readlink -f "$HOME/.zshrc" 2>/dev/null || readlink "$HOME/.zshrc")"
    DOTFILES_DIR="$(cd "$(dirname "$link_target")" 2>/dev/null && pwd)"
  fi
fi
[ -z "$DOTFILES_DIR" ] && [ -d "$HOME/.dotfiles/.git" ] && DOTFILES_DIR="$HOME/.dotfiles"

if [ -n "$DOTFILES_DIR" ] && [ -d "$DOTFILES_DIR/.git" ]; then
  branch="$(git -C "$DOTFILES_DIR" branch --show-current 2>/dev/null || echo "detached")"
  hash="$(git -C "$DOTFILES_DIR" rev-parse --short HEAD 2>/dev/null || echo "")"
  report_ok "Repository path: $DOTFILES_DIR" "$branch ($hash)"

  if [ -z "$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null)" ]; then
    report_ok "Working tree clean" "No uncommitted changes"
  else
    report_warn "Working tree has uncommitted changes" "Run git status in $DOTFILES_DIR"
  fi
else
  report_fail "Dotfiles repository not found" "Checked ~/.dotfiles"
fi
echo ""

# 2. Symlink Integrity
printf "${C_BOLD}2. Configuration Symlinks${C_RESET}\n"
check_link() {
  local link_path="$1"
  local target_desc="$2"
  local expected_file="$3"

  if [ ! -e "$link_path" ] && [ ! -L "$link_path" ]; then
    report_fail "$link_path missing" "Run ./install.sh to link"
    return
  fi

  if [ -L "$link_path" ]; then
    local actual
    actual="$(readlink "$link_path" 2>/dev/null || true)"
    if [ -n "$expected_file" ] && [[ "$actual" != *"$expected_file"* ]]; then
      report_warn "$link_path points to unexpected target" "$actual"
    else
      report_ok "$link_path" "-> $actual"
    fi
  else
    report_warn "$link_path is a regular file (not symlink)" "Backup and replace with link"
  fi
}

check_link "$HOME/.zshrc" "Zsh main config" ".zshrc"
check_link "$HOME/.aliases" "Zsh aliases" ".aliases"
check_link "$HOME/.gitconfig" "Global Git config" ".gitconfig"
check_link "$HOME/.gitignore_global" "Global Git ignore" ".gitignore_global"
check_link "$HOME/.config/starship.toml" "Starship prompt" "starship.toml"
check_link "$HOME/.config/nvim" "Neovim config" "nvim"
check_link "$HOME/.config/ghostty/config" "Ghostty config" "ghostty/config"
check_link "$HOME/.config/bat/config" "Bat syntax viewer config" "bat/config"
check_link "$HOME/.config/eza/theme.yml" "Eza theme config" "eza/theme.yml"
check_link "$HOME/.config/mise/config.toml" "Mise config" "mise/config.toml"
echo ""

# 3. Core Development CLI Tools
printf "${C_BOLD}3. Core CLI Tools${C_RESET}\n"
check_tool() {
  local bin="$1"
  local label="${2:-$1}"
  local ver_cmd="${3:-$bin --version}"

  if command -v "$bin" &>/dev/null; then
    local ver
    ver="$(eval "$ver_cmd" 2>/dev/null | head -n 1 | awk '{print $1,$2,$3}' || true)"
    report_ok "$label" "${ver:-installed}"
  else
    report_warn "$label not found in PATH" "Install via ./install.sh"
  fi
}

check_tool "git"      "Git version control" "git --version"
check_tool "zsh"      "Zsh shell"           "zsh --version"
check_tool "rg"       "ripgrep (rg)"        "rg --version"
check_tool "fd"       "fd / fdfind"         "fd --version 2>/dev/null || fdfind --version"
check_tool "fzf"      "fzf fuzzy finder"    "fzf --version"
check_tool "zoxide"   "zoxide (z)"          "zoxide --version"
check_tool "starship" "Starship prompt"     "starship --version"
check_tool "eza"      "eza modern ls"       "eza --version"
check_tool "atuin"    "Atuin shell history" "atuin --version"
check_tool "bat"      "bat syntax viewer"   "bat --version"
check_tool "mise"     "Mise runtime manager""mise --version"
check_tool "node"     "Node.js runtime"     "node -v"
check_tool "bun"      "Bun runtime"         "bun -v"
check_tool "nvim"     "Neovim editor"       "nvim --version"
check_tool "yazi"     "Yazi file manager"   "yazi --version"
check_tool "dust"     "dust disk analyzer"  "dust --version"
check_tool "btop"     "btop system monitor" "btop --version"
if command -v brew &>/dev/null; then
  check_tool "brew"   "Homebrew manager"    "brew --version"
  if [ -f "$DOTFILES_DIR/Brewfile" ]; then
    report_ok "Brewfile manifest" "Present ($DOTFILES_DIR/Brewfile)"
  fi
fi
gpg_format="$(git config --get gpg.format 2>/dev/null || echo "openpgp")"
if [ "$gpg_format" != "ssh" ]; then
  check_tool "gpg"    "GnuPG encryption"    "gpg --version"
fi
echo ""

# 4. UTF-8 Locale Health
printf "${C_BOLD}4. Locale & Multibyte Support${C_RESET}\n"
current_locale="${LC_ALL:-${LANG:-C}}"
if [ "$current_locale" = "C" ] || [ "$current_locale" = "POSIX" ]; then
  report_warn "Terminal locale is $current_locale" "Emojis & box borders may misalign"
else
  report_ok "Active locale: $current_locale" "UTF-8 capable"
fi

# Test multibyte character width via Zsh
if command -v zsh &>/dev/null; then
  if zsh -c '[ "${#${:-🐧}}" -eq 1 ]' 2>/dev/null; then
    report_ok "Zsh multibyte parsing" "Single-char UTF-8 glyphs confirmed"
  else
    report_warn "Zsh single-byte mode active" "Run in UTF-8 locale (e.g. C.UTF-8 / en_US.UTF-8)"
  fi
fi
echo ""

# 5. Git Configuration & Signing
printf "${C_BOLD}5. Git Identity & Commit Signing${C_RESET}\n"
user_name="$(git config --get user.name 2>/dev/null || true)"
user_email="$(git config --get user.email 2>/dev/null || true)"
gpg_signing="$(git config --get commit.gpgsign 2>/dev/null || echo "false")"
gpg_key="$(git config --get user.signingkey 2>/dev/null || echo "not set")"

if [ -n "$user_name" ]; then
  report_ok "Git user.name" "$user_name"
else
  report_warn "Git user.name not set" "Set via: git config --global user.name 'Your Name'"
fi

if [ -n "$user_email" ]; then
  report_ok "Git user.email" "$user_email"
else
  report_warn "Git user.email not set" "Set via: git config --global user.email 'you@example.com'"
fi

if [ "$gpg_signing" = "true" ]; then
  if [ "$gpg_format" = "ssh" ]; then
    report_ok "Commit signing" "Enabled via SSH (key: $gpg_key)"
  else
    report_ok "Commit signing" "Enabled via GPG (key: $gpg_key)"
    if [ -n "$GPG_TTY" ]; then
      report_ok "GPG_TTY exported" "$GPG_TTY"
    else
      report_warn "GPG_TTY not exported" "Add 'export GPG_TTY=\$(tty)' to ~/.zshrc"
    fi
  fi
else
  report_ok "Commit signing" "Disabled / manual"
fi
echo ""

# Summary
printf "${C_BOLD}Summary:${C_RESET} ${C_GREEN}%d passed${C_RESET}, ${C_YELLOW}%d warnings${C_RESET}, ${C_RED}%d failed${C_RESET}\n" \
  "$passed" "$warnings" "$failed"

if [ "$failed" -gt 0 ]; then
  echo ""
  printf "${C_RED}✖ Some checks failed. Run ./install.sh to fix missing dependencies.${C_RESET}\n"
  exit 1
elif [ "$warnings" -gt 0 ]; then
  echo ""
  printf "${C_YELLOW}⚠ All critical items OK, but some recommended tools or settings need attention.${C_RESET}\n"
  exit 0
else
  echo ""
  printf "${C_GREEN}✔ Your dotfiles environment is in top shape!${C_RESET}\n"
  exit 0
fi
