#!/usr/bin/env bash
# ==============================================================================
# dottest — Deep Dotfiles Integration & Runtime Test Suite
# Tests runtime configuration parsers, schema validation, headless tool boots,
# shell startup integrity, and script syntax.
# ==============================================================================
set -u

# Resolve physical script location even when invoked via symlinks (e.g. ~/.local/bin/.test)
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -L "$TARGET_FILE" ]; do
    LINK_TARGET="$(readlink "$TARGET_FILE")"
    if [[ "$LINK_TARGET" == /* ]]; then
        TARGET_FILE="$LINK_TARGET"
    else
        TARGET_FILE="$(dirname "$TARGET_FILE")/$LINK_TARGET"
    fi
done
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$TARGET_FILE")/.." && pwd)}"

# Catppuccin Mocha Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_MAUVE="\033[38;2;203;166;247m"
C_BLUE="\033[38;2;137;180;250m"
C_GREEN="\033[38;2;166;227;161m"
C_RED="\033[38;2;243;139;168m"
C_YELLOW="\033[38;2;249;226;175m"
C_SURFACE="\033[38;2;88;91;112m"

PASSED=0
FAILED=0
WARNED=0

print_header() {
    echo ""
    echo -e "${C_MAUVE}╭────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_MAUVE}│${C_RESET}  ${C_BOLD}Dotfiles Test Suite — Deep Runtime & Schema Checker   ${C_RESET}${C_MAUVE}│${C_RESET}"
    echo -e "${C_MAUVE}╰────────────────────────────────────────────────────────╯${C_RESET}"
    echo ""
}

test_pass() {
    local name="$1"
    local detail="${2:-}"
    PASSED=$((PASSED + 1))
    printf "  ${C_GREEN}✔${C_RESET} %-44s ${C_SURFACE}%s${C_RESET}\n" "$name" "$detail"
}

test_fail() {
    local name="$1"
    local error_msg="${2:-Failed}"
    FAILED=$((FAILED + 1))
    printf "  ${C_RED}✖${C_RESET} ${C_BOLD}%-44s${C_RESET} ${C_RED}%s${C_RESET}\n" "$name" "$error_msg"
}

test_warn() {
    local name="$1"
    local warning="${2:-Warning}"
    WARNED=$((WARNED + 1))
    printf "  ${C_YELLOW}⚠${C_RESET} %-44s ${C_YELLOW}%s${C_RESET}\n" "$name" "$warning"
}

print_header

# ==============================================================================
# 1. Configuration & Runtime Parsers
# ==============================================================================
echo -e "${C_BOLD}1. Configuration & Runtime Parsers${C_RESET}"

# 1a. Yazi (PTY Headless Boot & Schema Check)
if command -v yazi &>/dev/null; then
    yazi_out=$(python3 -c '
import pty, os, time, sys

master, slave = pty.openpty()
pid = os.fork()
if pid == 0:
    os.close(master)
    os.dup2(slave, 0)
    os.dup2(slave, 1)
    os.dup2(slave, 2)
    os.close(slave)
    os.execvp("yazi", ["yazi"])
else:
    os.close(slave)
    time.sleep(0.2)
    os.write(master, b"q")
    time.sleep(0.2)
    output = b""
    try:
        while True:
            chunk = os.read(master, 1024)
            if not chunk: break
            output += chunk
    except OSError:
        pass
    os.close(master)
    os.waitpid(pid, 0)
    text = output.decode("utf-8", errors="ignore")
    if "Failed to parse config" in text or "TOML parse error" in text:
        sys.stderr.write(text)
        sys.exit(1)
    sys.exit(0)
' 2>&1)
    if [ $? -eq 0 ]; then
        test_pass "Yazi configuration" "yazi.toml & theme.toml valid"
    else
        err_line=$(echo "$yazi_out" | grep -E "TOML parse error|error|Failed" | head -n 1)
        test_fail "Yazi configuration" "${err_line:-Config parse error}"
    fi
else
    test_warn "Yazi configuration" "yazi binary not found (skipped)"
fi

# 1b. Ghostty Config Validation
if command -v ghostty &>/dev/null; then
    ghostty_err=$(ghostty +validate-config 2>&1 || true)
    if [ -z "$ghostty_err" ]; then
        test_pass "Ghostty terminal configuration" "ghostty/config valid"
    else
        test_fail "Ghostty terminal configuration" "$ghostty_err"
    fi
else
    test_warn "Ghostty terminal configuration" "ghostty not installed (skipped)"
fi

# 1c. Neovim Headless Boot (Lua syntax & plugin load)
if command -v nvim &>/dev/null; then
    nvim_err=$(nvim --headless "+qa" 2>&1 || true)
    if [ $? -eq 0 ] && ! echo "$nvim_err" | grep -qiE "error|syntax|failed|deprecated"; then
        test_pass "Neovim headless initialization" "Lua config & plugins clean"
    else
        test_fail "Neovim headless initialization" "$(echo "$nvim_err" | head -n 1)"
    fi
else
    test_warn "Neovim headless initialization" "nvim binary not found (skipped)"
fi

# 1d. Starship Prompt Schema & Render
if command -v starship &>/dev/null; then
    if starship prompt --status=0 --terminal-width=80 &>/dev/null; then
        test_pass "Starship prompt configuration" "starship.toml renders clean"
    else
        test_fail "Starship prompt configuration" "Schema error in starship.toml"
    fi
else
    test_warn "Starship prompt configuration" "starship binary not found (skipped)"
fi

# 1e. Bat Syntax Viewer Config & Theme
if command -v bat &>/dev/null; then
    bat_themes=$(bat --list-themes 2>/dev/null || true)
    if echo "$bat_themes" | grep -q "Catppuccin Mocha"; then
        test_pass "Bat syntax viewer theme" "Catppuccin Mocha active"
    else
        test_fail "Bat syntax viewer theme" "Catppuccin Mocha theme missing"
    fi
else
    test_warn "Bat syntax viewer theme" "bat binary not found (skipped)"
fi

# 1f. Eza Modern ls & Theme
if command -v eza &>/dev/null; then
    eza_err=$(eza --icons --group-directories-first "$DOTFILES_DIR" 2>&1 >/dev/null || true)
    if [ -z "$eza_err" ]; then
        test_pass "Eza theme configuration" "eza/theme.yml parses clean"
    else
        test_fail "Eza theme configuration" "$eza_err"
    fi
else
    test_warn "Eza theme configuration" "eza binary not found (skipped)"
fi

# 1g. Mise Polyglot Runtime Config
if command -v mise &>/dev/null; then
    mise_err=$(mise ls 2>&1 >/dev/null || true)
    if [ -z "$mise_err" ]; then
        test_pass "Mise runtime configuration" "mise/config.toml valid"
    else
        test_fail "Mise runtime configuration" "$mise_err"
    fi
else
    test_warn "Mise runtime configuration" "mise binary not found (skipped)"
fi

# 1h. Git Global Configuration
if command -v git &>/dev/null; then
    if git config --list &>/dev/null; then
        test_pass "Git configuration" ".gitconfig syntax valid"
    else
        test_fail "Git configuration" ".gitconfig syntax error"
    fi
else
    test_fail "Git configuration" "git binary not found"
fi

# 1i. Windows Terminal JSON Schema
if [ -f "$DOTFILES_DIR/windows-terminal/settings.json" ]; then
    if python3 -m json.tool "$DOTFILES_DIR/windows-terminal/settings.json" &>/dev/null; then
        test_pass "Windows Terminal configuration" "settings.json valid JSON"
    else
        test_fail "Windows Terminal configuration" "Invalid JSON in settings.json"
    fi
fi

echo ""

# ==============================================================================
# 2. Shell Runtime & Clean Interactive Startup
# ==============================================================================
echo -e "${C_BOLD}2. Shell Runtime & Interactive Startup${C_RESET}"

TMP_STDERR="$(mktemp)"
cleanup() { rm -f "$TMP_STDERR"; }
trap cleanup EXIT

if ! command -v zsh &>/dev/null; then
    test_fail "Interactive Zsh startup" "zsh binary not found on system"
    test_fail "Custom shell functions" "zsh binary not found"
    test_fail "Completions engine" "zsh binary not found"
else
    # 2a. Interactive Zsh Boot Stderr Inspection
    zsh_start=$(python3 -c 'import time; print(time.time())')
    ZSH_STARTUP_VERBOSE=false zsh -i -c exit 2> "$TMP_STDERR" || true
    zsh_end=$(python3 -c 'import time; print(time.time())')
    zsh_elapsed=$(python3 -c "print(int(($zsh_end - $zsh_start) * 1000))")

    # Filter benign terminal warnings in CI environments (e.g. not a tty)
    critical_errors=$(grep -iE "command not found|parse error|syntax error|job table full|no such file" "$TMP_STDERR" 2>/dev/null || true)

    if [ -z "$critical_errors" ]; then
        test_pass "Interactive Zsh startup" "0 errors on boot (${zsh_elapsed}ms)"
    else
        test_fail "Interactive Zsh startup" "$(echo "$critical_errors" | head -n 1)"
    fi

    # 2b. Startup Performance Budget (< 350ms)
    if [ "$zsh_elapsed" -lt 350 ]; then
        test_pass "Startup latency budget (<350ms)" "Fast boot: ${zsh_elapsed}ms"
    else
        test_warn "Startup latency budget (<350ms)" "Exceeded target: ${zsh_elapsed}ms"
    fi

    # 2c. Custom Functions Registered in Shell
    funcs_check=$(zsh -i -c '
    for fn in take up groot conf clone port wt y copy paste extract npmr bunr pnpmr fa toggle-autols; do
        if ! (( $+functions[$fn] )); then
            echo "Missing function: $fn"
        fi
    done
    ' 2>/dev/null || true)

    if [ -z "$funcs_check" ]; then
        test_pass "Custom shell functions" "All 16 functions registered in zsh"
    else
        test_fail "Custom shell functions" "$(echo "$funcs_check" | head -n 1)"
    fi

    # 2d. Completions Engine & Functions
    comps_check=$(zsh -i -c '
    for comp in _git _uv _fzf_complete; do
        if ! (( $+functions[$comp] )); then
            echo "Missing completion: $comp"
        fi
    done
    ' 2>/dev/null || true)

    if [ -z "$comps_check" ]; then
        test_pass "Completions engine" "_git, _uv, and _fzf_complete active"
    else
        test_fail "Completions engine" "$(echo "$comps_check" | head -n 1)"
    fi
fi

echo ""

# ==============================================================================
# 3. Script Syntax & Link Integrity
# ==============================================================================
echo -e "${C_BOLD}3. Script Syntax & Link Integrity${C_RESET}"

# 3a. Bash Scripts Syntax Validation (bash -n)
bash_syntax_fail=false
for script in "$DOTFILES_DIR/install.sh" "$DOTFILES_DIR/install/"*.sh "$DOTFILES_DIR/bin/"*; do
    if [ -f "$script" ]; then
        if head -n 1 "$script" 2>/dev/null | grep -qE '^#!.*(bash|sh)'; then
            if ! bash -n "$script" 2>/dev/null; then
                test_fail "Bash syntax: $(basename "$script")" "Syntax error"
                bash_syntax_fail=true
            fi
        fi
    fi
done
if [ "$bash_syntax_fail" = false ]; then
    test_pass "Bash scripts syntax" "All bin/* and install/*.sh pass (bash -n)"
fi

# 3b. Zsh Scripts Syntax Validation (zsh -n)
if ! command -v zsh &>/dev/null; then
    test_fail "Zsh scripts syntax" "zsh binary not found"
else
    zsh_syntax_fail=false
    for zscript in "$DOTFILES_DIR/.zshrc" "$DOTFILES_DIR/.aliases" "$DOTFILES_DIR/zsh/"*.zsh "$DOTFILES_DIR/zsh/functions/"*.zsh; do
        if [ -f "$zscript" ] && ! zsh -n "$zscript" 2>/dev/null; then
            test_fail "Zsh syntax: $(basename "$zscript")" "Syntax error"
            zsh_syntax_fail=true
        fi
    done
    if [ "$zsh_syntax_fail" = false ]; then
        test_pass "Zsh scripts syntax" "All zsh/* and functions pass (zsh -n)"
    fi
fi

# 3c. Dangling Symlink Inspection
dangling_symlinks=()
for target in "$HOME/.zshrc" "$HOME/.aliases" "$HOME/.gitconfig" "$HOME/.config/starship.toml" "$HOME/.config/nvim" "$HOME/.config/ghostty/config" "$HOME/.config/bat/config" "$HOME/.config/eza/theme.yml" "$HOME/.config/mise/config.toml" "$HOME/.config/yazi"; do
    if [ -L "$target" ] && [ ! -e "$target" ]; then
        dangling_symlinks+=("$target")
    fi
done

if [ ${#dangling_symlinks[@]} -eq 0 ]; then
    test_pass "Symlink health" "All configuration symlinks point to valid targets"
else
    test_fail "Symlink health" "Dangling symlinks: ${dangling_symlinks[*]}"
fi

echo ""

# ==============================================================================
# Test Results Summary
# ==============================================================================
echo -e "${C_BOLD}Summary:${C_RESET} ${C_GREEN}${PASSED} passed${C_RESET}, ${C_YELLOW}${WARNED} warnings${C_RESET}, ${C_RED}${FAILED} failed${C_RESET}"
echo ""

if [ "$FAILED" -gt 0 ]; then
    echo -e "${C_RED}✖ Test suite failed! Please review the errors above.${C_RESET}"
    exit 1
else
    echo -e "${C_GREEN}✔ All deep integration tests passed successfully!${C_RESET}"
    exit 0
fi
