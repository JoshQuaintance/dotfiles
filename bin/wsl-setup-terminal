#!/usr/bin/env bash
# Description: Configure Windows Terminal from inside WSL (Catppuccin Mocha + Nerd Fonts)
# ==============================================================================
# wsl-setup-terminal — Configure Windows Terminal from inside WSL
# Injects Catppuccin Mocha theme, Miracode + FiraCode NF fonts, and 12px padding
# ==============================================================================
set -euo pipefail

# Ensure running under WSL
if [ -z "${WSL_DISTRO_NAME:-}" ] && ! grep -qi microsoft /proc/version 2>/dev/null; then
  echo -e "\033[38;2;249;226;175m[WARN]\033[0m This utility is designed to be executed inside WSL."
  echo "On macOS or Linux, your terminal configuration is managed via ~/.config/ghostty/config."
  exit 0
fi

if ! command -v powershell.exe &>/dev/null; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m powershell.exe is not accessible from WSL."
  exit 1
fi

echo -e "\033[38;2;137;180;250m[INFO]\033[0m Locating Windows Terminal settings on Windows host..."

# Retrieve Windows LocalAppData
WIN_LOCALAPPDATA=$(powershell.exe -NoProfile -Command '$env:LOCALAPPDATA' 2>/dev/null | tr -d '\r')
if [ -z "$WIN_LOCALAPPDATA" ] || ! command -v wslpath &>/dev/null; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m Unable to resolve Windows LocalAppData path."
  exit 1
fi

LOCALAPPDATA_MOUNT="$(wslpath "$WIN_LOCALAPPDATA")"

# Search for settings.json across known package IDs
SETTINGS_FILE=""
CANDIDATE_PATHS=(
  "$LOCALAPPDATA_MOUNT/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json"
  "$LOCALAPPDATA_MOUNT/Packages/Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe/LocalState/settings.json"
  "$LOCALAPPDATA_MOUNT/Microsoft/Windows Terminal/settings.json"
)

for path in "${CANDIDATE_PATHS[@]}"; do
  if [ -f "$path" ]; then
    SETTINGS_FILE="$path"
    break
  fi
done

if [ -z "$SETTINGS_FILE" ]; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m Windows Terminal settings.json not found."
  echo "Please ensure Windows Terminal is installed on Windows and has been launched at least once."
  exit 1
fi

echo -e "\033[38;2;166;227;161m[✔]\033[0m Found Windows Terminal settings at:"
echo "    $SETTINGS_FILE"

# Backup original configuration
BACKUP_FILE="${SETTINGS_FILE}.bak.$(date +%Y%m%d%H%M%S)"
cp "$SETTINGS_FILE" "$BACKUP_FILE"
echo -e "\033[38;2;166;227;161m[✔]\033[0m Backup saved to $BACKUP_FILE"

# Resolve canonical template in dotfiles repo
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
TEMPLATE_FILE="$DOTFILES_DIR/config/windows-terminal/settings.json"

if [ ! -f "$TEMPLATE_FILE" ]; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m Canonical template not found at $TEMPLATE_FILE"
  exit 1
fi

# Safely merge canonical template into Windows Terminal settings.json (supports JSONC comments/trailing commas)
"$DOTFILES_DIR/libexec/wsl_terminal_settings.py" "$SETTINGS_FILE" "$TEMPLATE_FILE"

echo -e "\033[38;2;166;227;161m[✔]\033[0m Windows Terminal setup complete! Restart or switch tabs in Windows Terminal to see the new theme."
