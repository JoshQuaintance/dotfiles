#!/usr/bin/env bash
# Description: Configure Windows Terminal from inside WSL (Catppuccin Mocha + Nerd Fonts)
# ==============================================================================
# wsl-setup-terminal — Configure Windows Terminal from inside WSL
# Injects Catppuccin Mocha theme, Miracode + FiraCode NF fonts, and 12px padding
# ==============================================================================
set -euo pipefail

# Ensure running under WSL
if [ -z "${WSL_DISTRO_NAME:-}" ] && ! grep -qi microsoft /proc/version 2>/dev/null; then
  echo -e "\033[38;2;249;226;175m[WARN]\033[0m This utility is designed to be executed inside WSL."
  echo "On macOS or Linux, your terminal configuration is managed via ~/.config/ghostty/config."
  exit 0
fi

if ! command -v powershell.exe &>/dev/null; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m powershell.exe is not accessible from WSL."
  exit 1
fi

echo -e "\033[38;2;137;180;250m[INFO]\033[0m Locating Windows Terminal settings on Windows host..."

# Retrieve Windows LocalAppData
WIN_LOCALAPPDATA=$(powershell.exe -NoProfile -Command '$env:LOCALAPPDATA' 2>/dev/null | tr -d '\r')
if [ -z "$WIN_LOCALAPPDATA" ] || ! command -v wslpath &>/dev/null; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m Unable to resolve Windows LocalAppData path."
  exit 1
fi

LOCALAPPDATA_MOUNT="$(wslpath "$WIN_LOCALAPPDATA")"

# Search for settings.json across known package IDs
SETTINGS_FILE=""
CANDIDATE_PATHS=(
  "$LOCALAPPDATA_MOUNT/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json"
  "$LOCALAPPDATA_MOUNT/Packages/Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe/LocalState/settings.json"
  "$LOCALAPPDATA_MOUNT/Microsoft/Windows Terminal/settings.json"
)

for path in "${CANDIDATE_PATHS[@]}"; do
  if [ -f "$path" ]; then
    SETTINGS_FILE="$path"
    break
  fi
done

if [ -z "$SETTINGS_FILE" ]; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m Windows Terminal settings.json not found."
  echo "Please ensure Windows Terminal is installed on Windows and has been launched at least once."
  exit 1
fi

echo -e "\033[38;2;166;227;161m[✔]\033[0m Found Windows Terminal settings at:"
echo "    $SETTINGS_FILE"

# Backup original configuration
BACKUP_FILE="${SETTINGS_FILE}.bak.$(date +%Y%m%d%H%M%S)"
cp "$SETTINGS_FILE" "$BACKUP_FILE"
echo -e "\033[38;2;166;227;161m[✔]\033[0m Backup saved to $BACKUP_FILE"

# Resolve canonical template in dotfiles repo
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
TEMPLATE_FILE="$DOTFILES_DIR/config/windows-terminal/settings.json"

if [ ! -f "$TEMPLATE_FILE" ]; then
  echo -e "\033[38;2;243;139;168m[ERROR]\033[0m Canonical template not found at $TEMPLATE_FILE"
  exit 1
fi

# Safely merge canonical template into Windows Terminal settings.json (supports JSONC comments/trailing commas)
python3 - "$SETTINGS_FILE" "$TEMPLATE_FILE" <<'EOF'
import json
import re
import sys

settings_path, template_path = sys.argv[1], sys.argv[2]


def parse_jsonc(raw: str) -> dict:
    # Strip // line comments and /* */ block comments outside double-quoted strings
    token_re = re.compile(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*[\s\S]*?\*/')
    stripped = token_re.sub(lambda m: m.group(0) if m.group(0).startswith('"') else "", raw)
    # Strip trailing commas before } or ]
    cleaned = re.sub(r",(\s*[}\]])", r"\1", stripped)
    return json.loads(cleaned)


try:
    with open(settings_path, "r", encoding="utf-8") as f:
        data = parse_jsonc(f.read())
    with open(template_path, "r", encoding="utf-8") as f:
        template = parse_jsonc(f.read())
except Exception as e:
    print(f"\033[38;2;243;139;168m[ERROR]\033[0m Failed to parse JSON: {e}", file=sys.stderr)
    sys.exit(1)

# 1. Merge top-level ergonomic flags (copyOnSelect, copyFormatting, trimBlockSelection)
for top_key in ("copyOnSelect", "copyFormatting", "trimBlockSelection"):
    if top_key in template:
        data[top_key] = template[top_key]

# 2. Merge color schemes from canonical template
if "schemes" not in data or not isinstance(data["schemes"], list):
    data["schemes"] = []

for tpl_scheme in template.get("schemes", []):
    scheme_name = tpl_scheme.get("name")
    if not scheme_name:
        continue
    scheme_idx = next((i for i, s in enumerate(data["schemes"]) if s.get("name") == scheme_name), None)
    if scheme_idx is not None:
        data["schemes"][scheme_idx] = tpl_scheme
    else:
        data["schemes"].append(tpl_scheme)

# 3. Merge profiles.defaults from canonical template (preserving user profiles.list)
if "profiles" not in data or not isinstance(data["profiles"], dict):
    data["profiles"] = {}

if "defaults" not in data["profiles"] or not isinstance(data["profiles"]["defaults"], dict):
    data["profiles"]["defaults"] = {}

tpl_defaults = template.get("profiles", {}).get("defaults", {})
for k, v in tpl_defaults.items():
    if k == "font" and isinstance(v, dict):
        if "font" not in data["profiles"]["defaults"] or not isinstance(data["profiles"]["defaults"]["font"], dict):
            data["profiles"]["defaults"]["font"] = {}
        data["profiles"]["defaults"]["font"].update(v)
    else:
        data["profiles"]["defaults"][k] = v

# 4. Merge ergonomic keybindings / actions (matched by "keys")
if "actions" in template and isinstance(template["actions"], list):
    target_key = "actions" if "actions" in data or "keybindings" not in data else "keybindings"
    if target_key not in data or not isinstance(data[target_key], list):
        data[target_key] = []
    for tpl_action in template["actions"]:
        keys = tpl_action.get("keys")
        if not keys:
            continue
        act_idx = next((i for i, a in enumerate(data[target_key]) if a.get("keys") == keys), None)
        if act_idx is not None:
            data[target_key][act_idx] = tpl_action
        else:
            data[target_key].append(tpl_action)

with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=4)

print("\033[38;2;166;227;161m[✔]\033[0m Successfully synced Windows Terminal settings from config/windows-terminal/settings.json!")
EOF

echo -e "\033[38;2;166;227;161m[✔]\033[0m Windows Terminal setup complete! Restart or switch tabs in Windows Terminal to see the new theme."
